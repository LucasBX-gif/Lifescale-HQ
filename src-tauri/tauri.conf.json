{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lifescale HQ",
  "version": "0.5.1",
  "identifier": "com.lifescale.hq",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lifescale HQ",
        "width": 920,
        "height": 156,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "theme": "Dark",
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "fx",
        "url": "fx.html",
        "title": "Lifescale HQ celebration",
        "width": 1200,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3RkJCRDA3ODFGQzM0QjcKUldTM05QeUJCNzM3VnpocXhuanFCRTJQdmJHMUIzTXVPamQ0STNuOHJDaDJZc3dzM0ZYWTRIZnkK",
      "endpoints": [
        "https://github.com/LucasBX-gif/Lifescale-HQ/releases/latest/download/latest.json"
      ]
    }
  }
}
